# ==============================
# AI Programming Mentor - Config
# ==============================

# --- Database ---
# SQLite (default, zero config)
DATABASE_URL=sqlite:///./ai_mentor.db

# PostgreSQL example (swap when ready):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_mentor_db

# --- Security ---
# IMPORTANT: Change this secret key in production!
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Provider ---
# Options: mock | openai | gemini
# Use "mock" to run fully without an API key (recommended for demo)
# Use "gemini" and provide GEMINI_API_KEY for Google Gemini
# Use "openai" and provide OPENAI_API_KEY for real OpenAI responses
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Admin Account (auto-created on first run) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# --- CORS ---
# Your frontend URL (use * for development)
FRONTEND_URL=*
